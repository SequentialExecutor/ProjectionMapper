<Window x:Class="ProjectionMapper.Views.OutputSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Destination output setup" Width="790" Height="470" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="Assign this installation's outputs" FontSize="20" FontWeight="Bold" /><TextBlock Text="The computer, projector identity, layout, or resolution changed. Choose a destination for each saved output. Preview only opens no projector window. Verify projector identities and recalibrate on the physical scene before performance." TextWrapping="Wrap" Margin="0,10" /></StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><CheckBox x:Name="RetainColor" Content="Copy saved color/blending to the chosen outputs (verify them on hardware)" Margin="0,10" /><CheckBox x:Name="Confirmed" Content="I have reviewed these assignments, including any Preview only destinations." Margin="0,6" /><TextBlock x:Name="Status" Foreground="DarkRed" TextWrapping="Wrap" /><WrapPanel HorizontalAlignment="Right"><Button Content="Use these assignments" Click="Apply_Click" Padding="12,6" Margin="6" /><Button Content="Cancel" IsCancel="True" Padding="12,6" Margin="6" /></WrapPanel></StackPanel>
  <DataGrid x:Name="Assignments" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
   <DataGrid.Columns><DataGridTextColumn Header="Saved output" Binding="{Binding Label}" IsReadOnly="True" Width="*" /><DataGridTemplateColumn Header="Destination" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Index" SelectedValue="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
