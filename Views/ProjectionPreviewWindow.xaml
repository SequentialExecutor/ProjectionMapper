<Window x:Class="ProjectionMapper.Views.ProjectionPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{x:Null}" Title="Projection preview" Background="Black" Foreground="White" FontFamily="Segoe UI" WindowStyle="None" ResizeMode="NoResize" WindowState="Normal" WindowStartupLocation="Manual" KeyDown="Preview_KeyDown">
 <Grid Background="Black">
  <Image x:Name="PreviewImage" Stretch="Uniform" />
  <TextBlock Text="No composed frame yet. Import media and start playback." Foreground="White" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ImportedVideos.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding ElementName=PreviewImage, Path=Source}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
  <Border VerticalAlignment="Bottom" Background="#CC10151D" Padding="16,10"><DockPanel><Button Content="Close preview · Esc / F5" Click="Close_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" /><TextBlock Text="Combined editor preview · Projector color corrections are shown only on physical outputs" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0" /></DockPanel></Border>
 </Grid>
</Window>
