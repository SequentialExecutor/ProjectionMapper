<Window Style="{DynamicResource {x:Type Window}}" x:Class="ProjectionMapper.Views.OutputDiagnosticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Output status" Width="920" Height="730" MinWidth="640" MinHeight="500" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="Check your projector outputs" Style="{StaticResource SectionTitle}" /><TextBlock x:Name="Summary" TextWrapping="Wrap" Margin="0,0,0,10" /><TextBlock Text="Software observations refresh once a second. Select a display for its routes and suggested checks." Style="{StaticResource MutedText}" Margin="0,0,0,10" /></StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="Scope" Style="{StaticResource MutedText}" Margin="0,10,0,4" /><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource Ui.Warning}" Margin="0,4" /><DockPanel LastChildFill="False"><TextBlock x:Name="Timestamp" Style="{StaticResource MutedText}" VerticalAlignment="Center" /><WrapPanel DockPanel.Dock="Right"><Button Content="Refresh" Click="Refresh_Click" Margin="0,0,8,0" /><Button x:Name="Export" Content="Export diagnostic JSON…" Style="{StaticResource PrimaryButton}" Click="Export_Click" Margin="0,0,8,0" /><Button Content="Close" Click="Close_Click" /></WrapPanel></DockPanel></StackPanel>
  <Grid><Grid.RowDefinitions><RowDefinition Height="3*" MinHeight="90" /><RowDefinition Height="10" /><RowDefinition Height="2*" MinHeight="80" /></Grid.RowDefinitions>
   <ListBox x:Name="Displays" SelectionChanged="Display_Changed"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,3"><DockPanel LastChildFill="False"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding State}" DockPanel.Dock="Right" Foreground="{DynamicResource Ui.AccentText}" Margin="16,0,0,0" /></DockPanel><TextBlock Text="{Binding Metrics}" TextWrapping="Wrap" Foreground="{DynamicResource Ui.Muted}" Margin="0,6,0,2" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
   <TextBox x:Name="Details" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
  </Grid>
 </DockPanel>
</Window>
