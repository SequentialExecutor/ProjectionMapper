<Window Style="{DynamicResource {x:Type Window}}" x:Class="ProjectionMapper.Views.CueControlsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cue settings" Width="460" Height="580" MinHeight="400" WindowStartupLocation="CenterOwner">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
  <TextBlock Text="Cue name" /><TextBox x:Name="CueName" Margin="0,5" />
  <TextBlock Text="Sources inside this cue" Margin="0,10,0,0" /><ComboBox x:Name="Playback" Margin="0,5" />
  <TextBlock Text="Advance to the next cue" Margin="0,10,0,0" /><ComboBox x:Name="Advance" Margin="0,5" />
  <TextBlock Text="Timed hold, seconds (1–86400; begins after fade-in)" /><TextBox x:Name="Seconds" Margin="0,5" />
  <TextBlock Text="Visual fade, seconds per leg (0–10)" /><TextBox x:Name="Fade" Margin="0,5" />
  <TextBlock Text="Transitions fade the outgoing image to black, switch cues, then fade in. Audio keeps the existing cue routing. Manual cues hold the final frame until Go. Changes take effect when the playlist is started again." TextWrapping="Wrap" Margin="0,10" />
  <TextBlock x:Name="Status" Foreground="{DynamicResource Ui.Warning}" TextWrapping="Wrap" />
  <WrapPanel HorizontalAlignment="Right" Margin="0,10"><Button Style="{StaticResource PrimaryButton}" Content="Apply" Click="Apply_Click" Padding="14,5" Margin="5" /><Button Content="Cancel" IsCancel="True" Padding="14,5" Margin="5" /></WrapPanel>
 </StackPanel></ScrollViewer>
</Window>
