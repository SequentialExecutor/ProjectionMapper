<Window Style="{DynamicResource {x:Type Window}}" x:Class="ProjectionMapper.Views.CameraCalibrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Camera-assisted planar calibration" Width="1280" Height="900" MinWidth="1000" MinHeight="750" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="14">
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource Ui.AccentText}" Margin="0,8" />
   <CheckBox x:Name="Confirmed" Margin="0,5"><TextBlock Text="I verified the projected outline on this single plane. The camera/projector stayed fixed and no digital crop/zoom changed between marking and capture. I accept the displayed pixel tolerance." TextWrapping="Wrap" /></CheckBox>
   <WrapPanel HorizontalAlignment="Right"><Button x:Name="Apply" Content="Apply to selected mesh" Click="Apply_Click" Padding="12,6" Margin="5" /><Button x:Name="CancelWork" Content="Cancel operation" Click="CancelWork_Click" Padding="12,6" Margin="5" IsEnabled="False" /><Button Content="Close without applying mapping" IsCancel="True" Padding="12,6" Margin="5" /></WrapPanel>
  </StackPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Controls">
    <TextBlock x:Name="Surface" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
    <ComboBox x:Name="Evidence" DisplayMemberPath="Label" Margin="0,6" />
    <WrapPanel><Button Content="Load saved draft" Click="Evidence_Click" /><Button x:Name="DeleteEvidence" Content="Remove saved evidence" Click="DeleteEvidence_Click" Margin="6,0" /></WrapPanel>
    <TextBlock Text="1. Restrict the marker region to ONE flat surface. Generate/project the pattern, then photograph it with a fixed camera. Other outputs are blanked during projection." TextWrapping="Wrap" Margin="0,8" />
    <TextBlock Text="Native output region: X, Y, width, height" />
    <WrapPanel Margin="0,5"><TextBox x:Name="RegionX" Width="70" Text="0" /><TextBox x:Name="RegionY" Width="70" Text="0" Margin="4,0" /><TextBox x:Name="RegionWidth" Width="70" /><TextBox x:Name="RegionHeight" Width="70" Margin="4,0" /></WrapPanel>
    <Button Content="Generate and project new markers" Click="Generate_Click" Margin="0,5" /><WrapPanel><Button Content="Export current pattern PNG…" Click="Export_Click" Margin="0,0,6,0" /><Button Content="Hide pattern" Click="Hide_Click" /></WrapPanel>
    <TextBlock x:Name="MarkerKey" TextWrapping="Wrap" FontSize="11" Margin="0,6" />
    <TextBlock Text="2. Import the marker photograph. Detection is local. Inspect IDs/centers; select a row and click its center to add or correct a match. Gold nodes are independent validation markers." TextWrapping="Wrap" Margin="0,8" />
    <Button Content="Import marker photograph…" Click="Import_Click" Margin="0,5" />
    <Button Content="Detect coded markers again" Click="Detect_Click" Margin="0,5" />
    <DataGrid x:Name="Markers" PreparingCellForEdit="MarkerEdit_Starting" Height="220" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
     <DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="40" /><DataGridCheckBoxColumn Header="Use" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" /><DataGridCheckBoxColumn Header="Check" Binding="{Binding ValidationOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="45" /><DataGridTextColumn Header="X (0–1)" Binding="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F5}" Width="65" /><DataGridTextColumn Header="Y (0–1)" Binding="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F5}" Width="65" /></DataGrid.Columns>
    </DataGrid>
    <WrapPanel Margin="0,8"><TextBlock Text="Tolerance (projector px)" VerticalAlignment="Center" /><TextBox x:Name="Tolerance" Text="3" Width="65" Margin="6,0" TextChanged="Input_Changed" /></WrapPanel>
    <TextBlock Text="At least five fit markers and two withheld check markers are required. Disabled markers do not contribute. A low training error alone is insufficient." TextWrapping="Wrap" FontSize="11" />
    <TextBlock Text="3. Choose content TL, TR, BR, BL on THIS photo. Existing scene-photo coordinates from another camera pose cannot be reused." TextWrapping="Wrap" Margin="0,10" />
    <WrapPanel><Button Content="Mark target corners" Click="Target_Click" /><Button Content="Use current quad as starting point" Click="CurrentQuad_Click" Margin="4,0" /></WrapPanel>
    <CheckBox x:Name="Extrapolate" Content="Allow limited extrapolation (maximum 10% of region)" Checked="Input_Changed" Unchecked="Input_Changed" Margin="0,8" />
    <Button Content="Fit and review errors" Click="Fit_Click" Margin="0,5" /><TextBlock x:Name="Metrics" TextWrapping="Wrap" FontWeight="Bold" />
    <Button Content="Project target outline for verification" Click="Preview_Click" Margin="0,8" />
    <TextBlock Text="No mapping changes until Apply. F12 blackout remains available. Curved/depth-varying surfaces and lens distortion need separate treatment." TextWrapping="Wrap" FontSize="11" />
   </StackPanel></ScrollViewer>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel><WrapPanel Margin="0,0,0,6"><TextBlock Text="Photo zoom / pan" VerticalAlignment="Center" /><Slider x:Name="PhotoZoom" Width="200" Minimum="0.25" Maximum="8" Value="0.9" ValueChanged="Zoom_Changed" Margin="8,0" /><Button Content="Fit photo" Click="FitPhoto_Click" /></WrapPanel>
    <TextBlock x:Name="PhotoInfo" Text="The imported calibration photo and editable marker/target overlay appear here." TextWrapping="Wrap" Margin="0,0,0,8" /></StackPanel>
    <ScrollViewer x:Name="PhotoScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><Grid x:Name="PhotoArea" Width="900" Height="675" Background="{DynamicResource Ui.Canvas}"><Grid.LayoutTransform><ScaleTransform ScaleX="{Binding ElementName=PhotoZoom, Path=Value}" ScaleY="{Binding ElementName=PhotoZoom, Path=Value}" /></Grid.LayoutTransform><Image x:Name="PhotoImage" Stretch="Fill" /><Canvas x:Name="Overlay" Background="Transparent" MouseLeftButtonDown="Photo_Click" /></Grid></ScrollViewer>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
