<Window Style="{DynamicResource {x:Type Window}}" x:Class="ProjectionMapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ProjectionMapper.Views"
        xmlns:vm="clr-namespace:ProjectionMapper.ViewModels"
        xmlns:models="clr-namespace:ProjectionMapper.Models"
        xmlns:conv="clr-namespace:ProjectionMapper.Converters"
        x:Name="Shell" Title="ProjectionMapper" Height="900" Width="1440" MinWidth="1024" MinHeight="680" WindowState="Maximized"
        Loaded="Window_Loaded">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Inverse boolean to visibility converter for showing/hiding based on negated condition -->
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding LoadProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsProjectCommand}" />
        <KeyBinding Key="F5" Command="{Binding PreviewCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyMeshCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteMeshCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteMeshCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="16,8,16,12">
        <Grid DockPanel.Dock="Top" Margin="0,6,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" Background="{DynamicResource Ui.Selection}" CornerRadius="9" Margin="0,0,11,0"><Path Data="M 7,12 L 26,6 L 26,26 L 7,29 Z M 7,12 L 26,26" Stroke="{DynamicResource Ui.Accent}" StrokeThickness="1.5" Stretch="None" /></Border>
                <StackPanel><TextBlock Text="ProjectionMapper" FontWeight="SemiBold" FontSize="17" /><TextBlock Text="Create light. Shape your space." Style="{StaticResource MutedText}" /></StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="{Binding ActiveProject.Name, TargetNullValue=Untitled project, FallbackValue=Untitled project}" TextTrimming="CharacterEllipsis" MaxWidth="360" HorizontalAlignment="Center" />
                <TextBlock Text="Unsaved changes" Foreground="{DynamicResource Ui.Warning}" FontSize="11" HorizontalAlignment="Center" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="PART_ThemeToggle" Content="Light mode" Style="{StaticResource QuietButton}" Click="ToggleAppearance_Click" ToolTip="Switch the editor appearance" Margin="0,0,8,0" /><Button Content="Save project" Command="{Binding SaveProjectCommand}" ToolTip="Save project · Ctrl+S" /></StackPanel>
        </Grid>
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="PART_FileMenu" Header="_File">
                <MenuItem Header="_New" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N" />
                <Separator />
                <MenuItem Header="_Open..." Command="{Binding LoadProjectCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Save" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsProjectCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="PART_EditMenu" Header="_Edit">
                <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
            </MenuItem>
            <MenuItem x:Name="PART_PlaylistMenu" Header="_Playlist">
                <MenuItem Header="Create Group" Command="{Binding CreateGroupCommand}" />
                <MenuItem Header="Delete Group" Command="{Binding DeleteGroupCommand}" />
                <Separator />
                <MenuItem Header="Move Group Up" Command="{Binding MoveGroupUpCommand}" />
                <MenuItem Header="Move Group Down" Command="{Binding MoveGroupDownCommand}" />
                <Separator />
                <MenuItem Header="Toggle Playlist Mode" Command="{Binding TogglePlaylistModeCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Appearance"><MenuItem x:Name="PART_DarkAppearance" Header="Dark" IsCheckable="True" Click="DarkAppearance_Click" /><MenuItem x:Name="PART_LightAppearance" Header="Light" IsCheckable="True" Click="LightAppearance_Click" /><MenuItem x:Name="PART_SystemAppearance" Header="Follow Windows" IsCheckable="True" Click="SystemAppearance_Click" /></MenuItem>
                <Separator />
                <MenuItem Header="_Preview" Command="{Binding PreviewCommand}" InputGestureText="F5" />
                <MenuItem Header="Output _status…" Click="OutputStatus_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" Style="{StaticResource PanelCard}" Padding="10,7" Margin="0,8,0,12">
            <DockPanel x:Name="PART_EditToolbar" LastChildFill="False">
                <Button Content="Import media" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" Padding="16,7" Margin="0,0,10,0" ToolTip="Start with a video or image source" />
                <Menu VerticalAlignment="Center">
                    <MenuItem Header="Create"><MenuItem Header="Photo to map…" Click="OpenPhotoMap_Click" /><MenuItem Header="AI artwork library…" Click="OpenArtwork_Click" /></MenuItem>
                    <MenuItem Header="Mapping"><MenuItem Header="Manual calibration…" Click="OpenCalibration_Click" /><MenuItem Header="Camera-assisted calibration…" Click="CameraCalibration_Click" /><Separator /><MenuItem Header="Masks and curved mesh…" Click="SurfaceControls_Click" /></MenuItem>
                    <MenuItem Header="Show setup"><MenuItem Header="Display resolutions…" Click="DisplayResolutions_Click" /><MenuItem x:Name="PART_OutputSetup" Header="Assign projector outputs…" Click="OutputSetup_Click" /><MenuItem x:Name="PART_OutputSettings" Header="Projector color and blending…" Click="OutputControls_Click" /><MenuItem x:Name="PART_CueSettings" Header="Selected cue settings…" Click="CueControls_Click" /></MenuItem>
                </Menu>
                <TextBlock x:Name="PART_DisplaySummary" DockPanel.Dock="Right" Style="{StaticResource MutedText}" Text="Outputs not configured" VerticalAlignment="Center" Margin="12,0,4,0" />
            </DockPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Background="Transparent" Foreground="{DynamicResource Ui.Muted}" Padding="0,8,0,0">
            <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="780" />
            <Separator /><TextBlock Text="{Binding MeshSelectionText}" Foreground="{DynamicResource Ui.AccentText}" />
        </StatusBar>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource PanelCard}" Margin="0,12,0,0" Padding="14,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="PART_CurrentCue" TextTrimming="CharacterEllipsis" FontSize="15" FontWeight="SemiBold" Text="Current cue: stopped" /><WrapPanel><TextBlock x:Name="PART_NextCue" Foreground="{DynamicResource Ui.Muted}" Margin="0,4,14,0" /><TextBlock x:Name="PART_NextCueNote" TextWrapping="Wrap" MaxWidth="280" Foreground="{DynamicResource Ui.Muted}" Margin="0,4,0,0" FontSize="11" /></WrapPanel></StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Image x:Name="PART_NextCueImage" Width="70" Height="42" Stretch="Uniform" Margin="0,0,12,0"><Image.Style><Style TargetType="Image"><Style.Triggers><Trigger Property="Source" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></Image.Style></Image>
                    <Button Content="Preflight &amp; rehearsal…" Click="Deployment_Click" Style="{StaticResource QuietButton}" Margin="0,0,10,0" />
                    <ToggleButton x:Name="PART_Performance" Content="Performance" Checked="Performance_Changed" Unchecked="Performance_Changed" ToolTip="Lock editing for the show · F10" Margin="0,0,10,0" />
                    <Button Command="{Binding PlayPauseCommand}" MinWidth="78" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Content" Value="Play" /><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Content" Value="Pause" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button Command="{Binding RestartCommand}" Content="↺" Style="{StaticResource IconButton}" Width="36" ToolTip="Restart playback" AutomationProperties.Name="Restart playback" Margin="0,0,8,0" />
                    <Button x:Name="PART_Go" Content="Go →" Click="Go_Click" Style="{StaticResource PrimaryButton}" MinWidth="85" ToolTip="Start or advance to the next cue · Space in performance mode" Margin="0,0,12,0" />
                    <Button x:Name="PART_Blackout" Content="Blackout · F12" Click="Blackout_Click" Style="{StaticResource DangerButton}" MinWidth="125" AutomationProperties.Name="Blackout or restore projector output, F12" />
                </WrapPanel>
            </Grid>
        </Border>
        <Grid x:Name="PART_EditorContent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="250" MaxWidth="440" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelCard}" Padding="12">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="2,0,2,8"><TextBlock Text="Project" FontSize="16" FontWeight="SemiBold" /><Button Content="New cue" Command="{Binding CreateGroupCommand}" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Padding="7,3" MinHeight="28" /></DockPanel>
                    <CheckBox Grid.Row="1" x:Name="PART_PlaylistModeToggle" IsChecked="{Binding IsPlaylistMode, Mode=TwoWay}" Content="Play as cue groups" ToolTip="Off: sources loop independently. On: sources play in ordered cue groups." Margin="2,0,0,8" />
                    <Grid Grid.Row="2">
                    <TreeView x:Name="PART_ProjectTree"
                              ItemsSource="{Binding ProjectTree}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              PreviewMouseRightButtonDown="TreeView_PreviewMouseRightButtonDown"
                              AllowDrop="True"
                              MinHeight="60"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <TreeView.Resources>
                            <!-- Template for Playlist Group -->
                            <HierarchicalDataTemplate DataType="{x:Type vm:PlaylistGroupTreeViewModel}" ItemsSource="{Binding Videos}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename Group" Click="RenameGroupMenuItem_Click" />
                                            <MenuItem Header="Delete Group" Click="DeleteGroupMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="Move Up" Click="MoveGroupUpMenuItem_Click" />
                                            <MenuItem Header="Move Down" Click="MoveGroupDownMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="Playback Mode">
                                                <MenuItem Header="Sequential (One at a Time)"
                                                          Click="SequentialModeMenuItem_Click"
                                                          IsCheckable="True"
                                                          IsChecked="{Binding IsSequentialMode, Mode=OneWay}" />
                                                <MenuItem Header="Simultaneous (All at Once)"
                                                          Click="SimultaneousModeMenuItem_Click"
                                                          IsCheckable="True"
                                                          IsChecked="{Binding IsSimultaneousMode, Mode=OneWay}" />
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Play This Group Now" Click="PlayGroupNowMenuItem_Click" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>

                                    <!-- Active indicator (green dot) -->
                                    <TextBlock Text="●"
                                               Foreground="{DynamicResource Ui.AccentText}"
                                               Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Margin="0,0,4,0"
                                               FontSize="14"
                                               ToolTip="Currently playing group" />

                                    <!-- Group icon -->
                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,4,0" FontSize="14" />

                                    <!-- Group name and video count -->
                                    <TextBlock Text="{Binding DisplayText}" FontWeight="Bold" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- Template for Imported Video (can be child of group or root) -->
                            <HierarchicalDataTemplate DataType="{x:Type vm:ImportedVideoTreeViewModel}" ItemsSource="{Binding ImportedVideo.MeshLayers}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu Opened="VideoContextMenu_Opened">
                                            <MenuItem Header="Create Mesh Layer" Click="CreateMeshMenuItem_Click" />
                                            <MenuItem Header="Create Sliced Mesh Layers">
                                                <MenuItem Header="2 Horizontal Slices" Click="CreateSlicedMeshMenuItem_Click" Tag="2" />
                                                <MenuItem Header="4 Horizontal Slices" Click="CreateSlicedMeshMenuItem_Click" Tag="4" />
                                                <MenuItem Header="6 Horizontal Slices" Click="CreateSlicedMeshMenuItem_Click" Tag="6" />
                                                <MenuItem Header="8 Horizontal Slices" Click="CreateSlicedMeshMenuItem_Click" Tag="8" />
                                                <MenuItem Header="10 Horizontal Slices" Click="CreateSlicedMeshMenuItem_Click" Tag="10" />
                                            </MenuItem>
                                            <MenuItem Header="Delete Source" Click="DeleteSourceMenuItem_Click" />
                                            <Separator />
                                            <MenuItem Header="Remove from Group"
                                                      Click="RemoveVideoFromGroupMenuItem_Click"
                                                      x:Name="PART_RemoveFromGroupMenuItem" />
                                            <MenuItem Header="Add to Group" x:Name="PART_AddToGroupMenuItem">
                                                <!-- Dynamic submenu populated in code-behind -->
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Copy Mesh" Click="CopyMeshMenuItem_Click" InputGestureText="Ctrl+C" />
                                            <MenuItem Header="Paste Mesh" Click="PasteMeshMenuItem_Click" InputGestureText="Ctrl+V" />
                                            <Separator />
                                            <MenuItem Header="Hide Source Output/Meshes" Tag="HideShowToggle" Click="HideSourceOutputMenuItem_Click" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>

                                    <!-- Video icon -->
                                    <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,4,0" FontSize="14" />

                                    <!-- Video name with audio indicator -->
                                    <TextBlock Text="{Binding DisplayText}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- Template for Mesh Layer (child of video) -->
                            <DataTemplate DataType="{x:Type vm:LayerViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu Opened="MeshContextMenu_Opened">
                                            <MenuItem Header="Rename Mesh" Click="RenameMeshMenuItem_Click" />
                                            <MenuItem x:Name="PART_DeleteMeshMenuItem" Header="Delete Mesh Layer" Click="DeleteMeshMenuItem_Click" />
                                            <Separator />
                                            <MenuItem x:Name="PART_CopyMeshMenuItem" Header="Copy Mesh" Click="CopyMeshMenuItem_Click" InputGestureText="Ctrl+C" />
                                            <MenuItem Header="Paste Mesh" Click="PasteMeshMenuItem_Click" InputGestureText="Ctrl+V" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>

                                    <!-- Multi-selection indicator (checkmark when part of multi-selection) -->
                                    <TextBlock Text="✓"
                                               Foreground="{DynamicResource Ui.AccentText}"
                                               FontWeight="Bold"
                                               Visibility="{Binding IsMultiSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Margin="0,0,2,0"
                                               FontSize="12"
                                               ToolTip="Part of multi-selection" />

                                    <!-- Mesh icon -->
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,4,0" FontSize="13" />

                                    <!-- Mesh name -->
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                        <TextBlock Text="Your sources and surfaces will appear here." TextAlignment="Center" Margin="14,20" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ProjectTree.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    </Grid>
                    <Button Grid.Row="3" Content="+ Add surface" Command="{Binding CreateMeshCommand}" Margin="0,8,0,10" ToolTip="Select a source, then create a mapped surface" />
                    <Border Grid.Row="4" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <ScrollViewer x:Name="PART_InspectorScroll" VerticalScrollBarVisibility="Auto" MaxHeight="240"><StackPanel>
                            <TextBlock Text="Inspector" Style="{StaticResource SectionTitle}" />
                            <CheckBox x:Name="PART_GlobalShowMeshOverlayCheckbox" Content="Show all projector outlines" IsChecked="False" Checked="OnGlobalShowMeshOverlayChanged" Unchecked="OnGlobalShowMeshOverlayChanged" Margin="0,0,0,8" />
                            <StackPanel DataContext="{Binding SelectedMeshLayer}" Visibility="{Binding ., Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="Projector" Style="{StaticResource MutedText}" Margin="0,0,0,3" />
                                <ComboBox x:Name="PART_MeshMonitorCombo" IsEnabled="{Binding CanEditMapping}" SelectedIndex="-1" AutomationProperties.Name="Projector for the selected surface" />
                                <DockPanel Margin="0,10,0,0"><TextBlock Text="Opacity" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}" DockPanel.Dock="Right" /></DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}" AutomationProperties.Name="Surface opacity" />
                                <CheckBox Content="Lock mapping" IsChecked="{Binding IsLocked, Mode=TwoWay}" />
                                <CheckBox Content="Show editing handles" IsChecked="{Binding Visible, Mode=TwoWay}" />
                                <CheckBox Content="Outline on projector" IsChecked="{Binding ShowOverlay, Mode=TwoWay}" />
                                <Button Content="Restore video content" Click="RestoreVideoArtwork_Click" Visibility="{Binding ArtworkAssetId, Converter={StaticResource NullToVisibilityConverter}}" HorizontalAlignment="Left" Margin="0,6" />
                            </StackPanel>
                            <StackPanel DataContext="{Binding SelectedImportedVideo}" Visibility="{Binding ., Converter={StaticResource NullToVisibilityConverter}}" Margin="0,8,0,0">
                                <TextBlock Text="Source audio" Style="{StaticResource MutedText}" />
                                <CheckBox x:Name="PART_PlayAudioCheckbox" Content="Play audio from this source" IsChecked="{Binding PlayAudio, Mode=TwoWay}" />
                                <TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                            </StackPanel>
                        </StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" ShowsPreview="True" />
            <Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelCard}" Padding="0" ClipToBounds="True"><DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,11" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="Source" FontSize="15" FontWeight="SemiBold" /><Button Content="Fit" Click="FitInput_Click" Style="{StaticResource QuietButton}" Padding="8,2" MinHeight="26" DockPanel.Dock="Right" /></DockPanel><TextBlock Text="Crop the media used by your surface" Style="{StaticResource MutedText}" Margin="0,2,0,5" /><DockPanel><TextBlock Text="{Binding InputZoom, StringFormat={}{0:P0}}" Width="46" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Muted}" /><Slider Minimum="0.1" Maximum="4" Value="{Binding InputZoom, Mode=TwoWay}" AutomationProperties.Name="Source preview zoom" /></DockPanel></StackPanel></Border>
                    <Grid Background="{DynamicResource Ui.Canvas}">
                        <ScrollViewer x:Name="PART_InputScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Grid x:Name="PART_InputCanvas" Width="{Binding ElementName=PART_InputHost, Path=CurrentFrame.PixelWidth, FallbackValue=1920, TargetNullValue=1920}" Height="{Binding ElementName=PART_InputHost, Path=CurrentFrame.PixelHeight, FallbackValue=1080, TargetNullValue=1080}">
                                <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding InputZoom}" ScaleY="{Binding InputZoom}" /></Grid.LayoutTransform>
                                <views:RenderHostControl x:Name="PART_InputHost" />
                                <views:MeshEditorControl x:Name="PART_MeshEditor" SelectedLayer="{Binding SelectedMeshLayer, Mode=TwoWay}" AllMeshLayers="{Binding SelectedImportedVideo.MeshLayers, Mode=OneWay}" SelectedSourceId="{Binding SelectedImportedVideo.HostLayer.Id, Mode=OneWay}" VideoService="{DynamicResource VideoService}" RendererManager="{DynamicResource RendererManager}" InputHost="{Binding ElementName=PART_InputHost}" ParentScrollViewer="{Binding ElementName=PART_InputScroll}" UndoRedoService="{Binding UndoRedoService}" Zoom="{Binding InputZoom, Mode=TwoWay}" />
                            </Grid>
                        </ScrollViewer>
                        <Border Background="{DynamicResource Ui.Canvas}" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ElementName=PART_InputHost, Path=CurrentFrame}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center" Margin="30"><TextBlock Text="Start with your media" Foreground="#EDF3FA" FontWeight="SemiBold" FontSize="20" TextWrapping="Wrap" TextAlignment="Center" /><TextBlock Text="Import a source, then add a surface. Select it in the project to adjust its crop." TextWrapping="Wrap" Foreground="#B2BFD1" TextAlignment="Center" Margin="0,10,0,0" /></StackPanel></Border>
                    </Grid>
                </DockPanel></Border>
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" ShowsPreview="True" />
                <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="0" ClipToBounds="True"><DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,11" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="Projection" FontSize="15" FontWeight="SemiBold" /><Button Content="Fit" Click="FitOutput_Click" Style="{StaticResource QuietButton}" Padding="8,2" MinHeight="26" DockPanel.Dock="Right" /></DockPanel><TextBlock Text="Position and shape the projector mapping" Style="{StaticResource MutedText}" Margin="0,2,0,5" /><DockPanel><TextBlock Text="{Binding OutputZoom, StringFormat={}{0:P0}}" Width="46" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Muted}" /><Slider Minimum="0.1" Maximum="4" Value="{Binding OutputZoom, Mode=TwoWay}" AutomationProperties.Name="Projection preview zoom" /></DockPanel></StackPanel></Border>
                    <Grid Background="{DynamicResource Ui.Canvas}">
                        <ScrollViewer x:Name="PART_OutputScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Grid x:Name="PART_OutputCanvas" Width="{Binding ElementName=PART_OutputHost, Path=CurrentFrame.PixelWidth, FallbackValue=1920, TargetNullValue=1920}" Height="{Binding ElementName=PART_OutputHost, Path=CurrentFrame.PixelHeight, FallbackValue=1080, TargetNullValue=1080}">
                                <Grid.LayoutTransform><ScaleTransform ScaleX="{Binding OutputZoom}" ScaleY="{Binding OutputZoom}" /></Grid.LayoutTransform>
                                <views:RenderHostControl x:Name="PART_OutputHost" />
                                <views:OutputMeshEditorControl SelectedLayer="{Binding SelectedMeshLayer, Mode=TwoWay}" AllMeshLayers="{Binding SelectedImportedVideo.MeshLayers, Mode=OneWay}" VideoService="{DynamicResource VideoService}" HostRenderHost="{Binding ElementName=PART_OutputHost}" RendererManager="{DynamicResource RendererManager}" UndoRedoService="{Binding UndoRedoService}" />
                            </Grid>
                        </ScrollViewer>
                        <Border Background="{DynamicResource Ui.Canvas}" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ImportedVideos.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center" Margin="30"><TextBlock Text="Your projection takes shape here" Foreground="#EDF3FA" FontWeight="SemiBold" FontSize="20" TextWrapping="Wrap" TextAlignment="Center" /><TextBlock Text="Create a mapped surface and assign a projector when you are ready to align it." Foreground="#B2BFD1" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel></Border>
                    </Grid>
                </DockPanel></Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
