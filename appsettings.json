{
  "PhotoMapping": {
    "VisionModel": "gpt-4.1-mini",
    "TimeoutSeconds": 120
  },
  "Deployment": {
    "MinimumFreeBytes": 67108864,
    "ProbeTimeoutSeconds": 10,
    "RehearsalSampleSeconds": 5,
    "MaximumSamples": 7200
  },
  "ProjectRecovery": {
    "IntervalSeconds": 60             // Set to 0 to disable periodic recovery snapshots
  },
  "FFmpeg": {
    "Path": "",               // If empty, expects ffmpeg binaries to be on PATH or placed in Native/ffmpeg
    "HwAccel": "Auto"         // "Auto", "D3D11VA", or "CPU"
  },
  "Renderer": {
    "Backend": "D3D11",       // "D3D11" or "Software"
    "DeviceIndex": 0
  },
  "Logging": {
    "LogFolder": "logs",
    "LogLevel": "Information"
  },
  "Playlist": {
    "EnableLooping": true,                // Whether the playlist loops back to the first group after the last group completes
    "GroupTransitionDelayMs": 500,        // Delay in milliseconds between group transitions
    "AutoCreateDefaultGroup": false,      // Whether to automatically create a default group when enabling playlist mode
    "ShowPlaylistPanelByDefault": true    // Whether to show the playlist panel by default in the UI
  }
}