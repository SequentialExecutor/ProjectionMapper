<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Run the real persistence implementation without requiring WPF or FFmpeg. -->
    <Compile Include="../../Services/ProjectService.cs" Link="ProjectService.cs" />
    <Compile Include="../../Services/ProjectRecoveryService.cs" Link="ProjectRecoveryService.cs" />
    <Compile Include="../../Services/IProjectService.cs" Link="IProjectService.cs" />
    <Compile Include="../../Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../Utilities/QuadGeometry.cs" Link="QuadGeometry.cs" />
    <Compile Include="../../Utilities/MapMapProjectImporter.cs" Link="MapMapProjectImporter.cs" />
  </ItemGroup>
</Project>
